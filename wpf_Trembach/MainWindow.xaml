<Window x:Class="wpf_Trembach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_Trembach"
        mc:Ignorable="d"
        Title="Заказ доставки" Height="700" Width="820" Background="#d4d4d4">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#695010" Padding="10" Height="45">
            <TextBlock Text="Заказ доставки" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        
        <Border DockPanel.Dock="Bottom" Background="AliceBlue" Padding="10">
            <TextBlock Text="Предварительная стоимость: 450 ₽" Foreground="Gray"/>
        </Border>
        
        <Border Background="White" CornerRadius="5" Margin="15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Отправитель" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Отправитель" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,15,10"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Телефон отправителя" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Получатель" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Получатель" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="0,0,15,0"/>
                        
                        <TextBlock Grid.Column="2" Text="Телефон получателя" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="3"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Адрес доставки" FontWeight="Bold" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Город" VerticalAlignment="Top" Margin="0,4,10,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,15,10"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Дом" VerticalAlignment="Top" Margin="0,4,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Улица" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,15,10"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Квартира" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата доставки" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,15,0"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="До двери" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton Content="До пункта выдачи" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                    <TextBlock Text="Комментарий курьеру" Margin="0,0,0,5"/>
                    <TextBox Height="60"/>
                </StackPanel>
                
                <StackPanel Grid.Row="5" Margin="0,0,0,10" >
                    <TextBlock Text="Параметры посылки" FontWeight="Bold" Margin="0,0,0,5"/>
                    <WrapPanel>
                        <CheckBox Content="Хрупкое" Margin="0,0,20,10"/>
                        <CheckBox Content="Не переворачивать" Margin="0,0,20,10"/>
                        <CheckBox Content="Позвонить заранее" Margin="0,0,20,10"/>
                        <CheckBox Content="Нужна упаковка" Margin="0,0,20,10"/>
                        <CheckBox Content="Страхование" Margin="0,0,20,10"/>
                    </WrapPanel>
                </StackPanel>
                
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Оформить" Width="100" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Width="100" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
